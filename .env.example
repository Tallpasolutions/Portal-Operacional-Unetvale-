# =====================================================================
# Variáveis de ambiente do Portal Operacional Unetvale.
#
# Copie para `.env` e preencha. O `.env` está no .gitignore — segredo não
# entra no repositório.
#
# Duas metades independentes:
#   * APP     — precisa estar na Vercel (Settings -> Environment Variables)
#   * COLETOR — só na máquina que roda dentro da rede Unetvale
# =====================================================================


# ===================== APP (Flask na Vercel) =========================

# Supabase -> Project Settings -> API
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave service_role. Ela IGNORA o RLS, então o controle de acesso é todo
# do Flask. Nunca exponha no front — o app só a usa no servidor.
SUPABASE_SERVICE_KEY=eyJhbGciOi...service_role...

# Assina o cookie de sessão (stateless, ok p/ serverless). Gere assim:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=troque-por-uma-string-aleatoria-longa

# Quem é ADMIN. É o e-mail, comparado em minúsculas — NÃO existe coluna de
# admin na tabela `usuarios`. Trocar aqui troca o administrador do portal,
# e é o único jeito de fazer isso.
ADMIN_EMAIL=admin@exemplo.com

# Token compartilhado com o coletor, se usar o endpoint /api/ingest.
INGEST_TOKEN=troque-por-um-token-secreto


# ===================== Módulo Troca de Poste =========================

# Envio de OS ao WVSA. DESLIGADO por padrão.
#
# Com `true`, o botão "Enviar ao WVSA" na aba Ordens de Serviço passa a criar
# ORDEM DE SERVIÇO REAL, que desloca equipe. Só ligue depois de validar o
# fluxo ponta a ponta — o processo `coletor/enviar_os.py` precisa estar
# rodando dentro da rede Unetvale, porque a Vercel não alcança o WVSA
# (IP privado, 10.170.74.79).
OS_ENVIO_HABILITADO=false


# ============ Reuniões: gravação, transcrição e ata (Groq) ===========
#
# Tudo abaixo é do APP — precisa estar na Vercel também. Sem GROQ_API_KEY o
# portal continua funcionando; só o card de Gravação avisa que a transcrição
# está indisponível.

# console.groq.com -> API Keys -> Create API Key. Plano gratuito, sem cartão.
GROQ_API_KEY=
# Ids dos modelos. NÃO ficam no código porque a Groq aposenta id
# periodicamente — cravado, o dia da aposentadoria vira um 400 incompreensível
# em produção. Confira os atuais em console.groq.com -> Docs -> Models.
#
# Valores abaixo conferidos na tabela da Groq em 28/08/2026:
#   * whisper-large-v3-turbo — 3x mais barato e mais rápido que o
#     whisper-large-v3, e nossos trechos de 2 min têm ~1 MB.
#   * openai/gpt-oss-120b — contexto de 131k, então reunião de até ~1h30 cabe
#     inteira numa chamada só.
# ⚠️ llama-3.3-70b-versatile e llama-3.1-8b-instant passaram a ser Enterprise
#    (Contact Sales) e NÃO servem mais aqui.
GROQ_MODELO_TRANSCRICAO=whisper-large-v3-turbo
GROQ_MODELO_TEXTO=openai/gpt-oss-120b

# Transcrever 2 min leva ~2s; gerar ata, ~10s. 45s é folga para o dia ruim e
# ainda cabe no tempo de uma função serverless.
GROQ_TIMEOUT=45

# Esforço de raciocínio do gpt-oss. Os tokens que ele gasta "pensando" saem do
# MESMO limite da resposta: com esforço alto ele estoura o limite e devolve
# texto VAZIO, sem erro. Em resumir e formatar ata, 'low' basta e derruba o
# raciocínio de ~400 tokens para ~14. Deixe em branco se trocar por um modelo
# que não seja de raciocínio — ele recusaria o parâmetro com HTTP 400.
GROQ_REASONING_EFFORT=low

# Teto de TOKENS POR MINUTO da conta. MEDIDO no header x-ratelimit-limit-tokens
# da propria API, nao lido na tabela do site: o tier gratuito (on_demand) da
# 8000, e a tabela mostra 250000, que e do Developer Plan.
#
# O max_tokens reservado para a RESPOSTA conta neste teto. Com 8000, uma
# transcricao de 60 min (~15.700 tokens) nunca cabe numa chamada: a ata sai
# das notas por trecho. Subiu de plano? Troque so este numero.
GROQ_TPM=8000

# Bucket PRIVADO do Supabase Storage onde os trechos de áudio ficam.
# Criar em: Storage -> New bucket -> "Public bucket" DESMARCADO.
REUNIAO_BUCKET=reuniao-audio

# Tamanho do trecho. 120s mantém cada upload em ~1 MB e cada requisição em
# poucos segundos — os dois limites que a Vercel impõe. Aumentar aproxima do
# limite de corpo da requisição; diminuir gasta mais chamadas do plano free.
REUNIAO_TRECHO_SEGUNDOS=120

# Retenção do ÁUDIO. A transcrição e a ata NÃO expiram: são colunas em
# `reunioes` e ficam para sempre. Passado esse prazo a ata não pode mais ser
# regerada, porque a fonte foi apagada.
REUNIAO_AUDIO_DIAS=30

# Acima deste tamanho a ata é montada a partir das notas por trecho, em vez da
# transcrição inteira. O limite é o contexto do modelo, medido em caracteres.
#
# 120k caracteres ~= 30k tokens em português, contra os 131k de contexto do
# gpt-oss-120b: reunião de até ~2h entra inteira numa chamada só. O valor
# anterior (30k) fazia TODA reunião de 1h cair no modo degradado — a ata saía
# dos resumos de trecho, não da transcrição.
REUNIAO_ATA_MAX_CHARS=16000

# Idioma passado ao Whisper. Sem isso ele às vezes decide que reunião em
# português com sigla técnica é espanhol, e devolve tradução.
REUNIAO_IDIOMA=pt

# ===================== COLETOR (máquina na rede) =====================
# Nada abaixo daqui vai para a Vercel.

# WVSA — usado pelo w8_client.py (IQI/IQM) e pelo enviar_os.py.
W8_BASE=https://wvsa8.unetvale.com.br
W8_USER=usuario
W8_PASS=senha

# As mesmas credenciais, com os nomes que o fetch_wvsa.py (Massivas) espera.
# Os dois pares existem por razão histórica; o enviar.py faz a ponte entre eles.
WVSA_USER=usuario
WVSA_PASS=senha

# Início do histórico que o extrator reconstrói com --full. DD/MM/AAAA.
# ⚠️ --full APAGA e regrava tudo a partir desta data. Faça backup do dados.db.
HISTORICO_INICIO=01/01/2026

# Onde o fetch_wvsa.py grava o payload de Massivas antes de enviar ao Supabase.
MODEL_OUT=model.json

# Intervalo, em segundos, com que o enviar_os.py --daemon observa a fila de OS.
OS_POLL_SEGUNDOS=2
